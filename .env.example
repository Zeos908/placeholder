# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never shipped to the client

# NVIDIA NIM (build.nvidia.com -> API key, starts with nvapi-)
NVIDIA_API_KEY=                     # server only
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Empty until an image model is chosen in Phase 6 (see lib/ai.ts).
# While empty, posts use the gradient placeholder (§9.4).
IMAGE_MODEL=
APP_URL=http://localhost:3000

# Limits
CHAT_DAILY_LIMIT=30
PREFETCH_AHEAD=10
IMAGE_WORKER_CONCURRENCY=2

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Source adapters (one per source, added in Phase 7)
# SOURCE_<NAME>_API_KEY=
